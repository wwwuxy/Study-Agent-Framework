# scripts/setup.sh 会在首次运行时生成独立 Fernet 密钥。备份它，否则无法解密已保存的 API Key。
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=sqlite:///./data/study.db
# 托管环境保持 false；仅自托管管理员可允许内网模型。
ALLOW_PRIVATE_PROVIDER_URLS=false
# 仅本地演示时开启；不会回退到 Fake 冒充真实模型。
ENABLE_FAKE_PROVIDER=false
# HTTPS 部署必须为 true；localhost HTTP 开发可 false。
COOKIE_SECURE=true
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_DIST=frontend/dist
STRUCTURED_RETRIES=2
PROVIDER_CALLS_PER_MINUTE=30
SESSION_HOURS=168
# Docker Compose 必需；使用足够长的随机密码。
POSTGRES_PASSWORD=
# M2 私有资料：仅保存原始字节，不做本地正文解析。
MATERIAL_STORAGE_DIR=data/materials
# 默认 20 MiB；最大可设 1073741824（1024 MiB），远端文件限制另计。
MATERIAL_MAX_BYTES=20971520
MATERIAL_MAX_SECTIONS=20
MATERIAL_WORKER_ENABLED=true
MATERIAL_JOB_ATTEMPTS=3
# PostgreSQL 安装 pgvector 并执行 scripts/pgvector.sql 后才开启。
PGVECTOR_ENABLED=false
# 可选：离线评测并重建状态后的 validated 参数 JSON；不配置则使用库默认／初始参数
# LEARNER_PARAMETERS_PATH=data/calibration/validated.json

# M4：后台只处理已有学习数据，不自动调用模型；手动分析才消耗模型配额
M4_WORKER_ENABLED=true
M4_TICK_SECONDS=60
M4_ANALYSIS_DAILY_CALL_LIMIT=10
M4_ANALYSIS_DAILY_TOKEN_LIMIT=100000
M4_ANALYSIS_MAX_OUTPUT_TOKENS=1500
M4_ANALYSIS_MAX_INPUT_BYTES=48000

# 已批改试卷：由当前用户模型识别
EXAM_MAX_BYTES=20971520
EXAM_WORKER_ENABLED=true
EXAM_MAX_IMAGES=20
EXAM_MAX_QUESTIONS=200
EXAM_JOB_ATTEMPTS=3
EXAM_MAX_OUTPUT_TOKENS=32000
EXAM_CALL_TIMEOUT_SECONDS=120
